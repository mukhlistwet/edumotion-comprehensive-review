{
  "name": "edumotion-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@edumotion/web run dev",
    "dev:mobile": "npm --workspace=@edumotion/mobile run dev:preview",
    "dev:api": "npm --workspace=@edumotion/api run start",
    "db:migrate": "npm --workspace=@edumotion/api run migrate",
    "db:seed": "npm --workspace=@edumotion/api run seed",
    "build": "npm --workspace=@edumotion/web run build && npm --workspace=@edumotion/mobile run build:preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
