# Backend API (@edumotion/api)
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Kosongkan DATABASE_URL untuk memakai PGlite PostgreSQL WASM lokal; isi postgres://... untuk PostgreSQL eksternal
DATABASE_URL=
PGLITE_DATA_DIR=./apps/api/data/pglite
JWT_SECRET=edumotion-local-dev-signing-secret-replace-in-prod
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175,http://127.0.0.1:4176,http://localhost:5173,http://localhost:5174
ALLOW_DEMO_PERSONA_LOGIN=true
AUTO_SEED_DEMO=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_AUTH=30

# Web Frontend (@edumotion/web)
VITE_ADAPTER_MODE=http
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Mobile Frontend (@edumotion/mobile)
EXPO_PUBLIC_ADAPTER_MODE=http
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
