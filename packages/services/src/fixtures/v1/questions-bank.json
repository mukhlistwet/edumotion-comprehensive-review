      },
      "content": {
        "stem": "Tentukan koordinat titik puncak parabola \\(f(x) = x^2 - 6x + 5\\).",
        "instruction": "Pilih koordinat (x_p, y_p) yang tepat.",
        "media": []
      },
      "interaction": {
        "options": [
          { "id": "opt_a", "label": "(3, -4)" },
          { "id": "opt_b", "label": "(-3, 4)" },
          { "id": "opt_c", "label": "(3, 4)" },
          { "id": "opt_d", "label": "(6, 5)" }
        ]
      },
      "answerSpec": {
        "correctOptionIds": ["opt_a"]
      },
      "scoring": {
        "method": "exact_match",
        "maxPoints": 10
      },
      "explanation": {
        "steps": [
          "Sumbu simetri \\(x_p = -\\frac{b}{2a} = -\\frac{-6}{2(1)} = 3\\)",
          "Nilai ekstrem \\(y_p = f(3) = 3^2 - 6(3) + 5 = 9 - 18 + 5 = -4\\)"
        ],
        "hints": ["Gunakan rumus sumbu simetri x_p = -b / (2a)."],
        "correctFeedback": "Tepat! Titik puncak berada di (3, -4).",
        "incorrectFeedback": "Hati-hati dengan tanda negatif pada b = -6."
      },
