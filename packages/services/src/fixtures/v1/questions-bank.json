      "metadata": {
        "code": "MAT-SMP-ALG-014",
        "title": "Uraian Penyelesaian 4x − 7 = 21",
        "curriculumId": "cur_merdeka",
        "curriculumVersionId": "ver_merdeka_2026",
        "gradeLevelId": "grade_smp_8",
        "subjectId": "subj_math",
        "topicId": "top_algebra_linear",
        "competencyIds": ["comp_solve_linear"],
        "difficulty": "hard",
        "bloomLevel": "evaluate",
        "locale": "id-ID",
        "estimatedSeconds": 180
      },
      "content": {
        "stem": "Jelaskan langkah demi langkah penyelesaian persamaan \\(4x - 7 = 21\\) beserta alasan operasi pada kedua ruas!",
        "instruction": "Tuliskan alasan tiap langkah pengerjaan, bukan hanya hasil akhirnya.",
        "media": []
      },
      "interaction": {
        "responseMode": "rich_text",
        "minWords": 6,
        "placeholder": "Langkah 1: Tambahkan 7 pada kedua ruas..."
      },
      "answerSpec": {
        "requiredKeywords": ["7", "28", "4", "7"],
        "sampleAnswer": "Tambahkan 7 pada kedua ruas sehingga 4x = 28. Bagi kedua ruas dengan 4 sehingga diperoleh x = 7."
      },
      "scoring": {
        "method": "weighted_rubric",
        "maxPoints": 15,
        "rubric": [
          { "id": "rub_1", "criterion": "Mengidentifikasi operasi invers (+7 pada kedua ruas)", "maxPoints": 5 },
          { "id": "rub_2", "criterion": "Menyederhanakan menjadi 4x = 28 dengan tepat", "maxPoints": 5 },
          { "id": "rub_3", "criterion": "Membagi kedua ruas dengan 4 dan menyimpulkan x = 7", "maxPoints": 5 }
        ]
      },
      "explanation": {
        "steps": [
          "Tambahkan 7 ke kedua ruas: \\(4x - 7 + 7 = 21 + 7 \\Rightarrow 4x = 28\\)",
          "Bagi kedua ruas dengan 4: \\(x = \\frac{28}{4} = 7\\)"
        ],
        "hints": ["Sebutkan operasi yang menjaga kesetaraan kedua ruas di setiap langkah."],
        "correctFeedback": "Penalaran langkah penyelesaianmu sangat jelas dan lengkap.",
        "incorrectFeedback": "Pastikan kamu menjelaskan alasan penambahan 7 dan pembagian dengan 4."
      },
